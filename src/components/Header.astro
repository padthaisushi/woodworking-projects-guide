---
const base = import.meta.env.BASE_URL;
---
<header>
  <nav>
    <a href={base} class="site-title">Sawdust & Plans</a>
    <div class="links">
      <a href={base}>Projects</a>
      <a href={`${base}about/`}>About</a>
    </div>
  </nav>
</header>

<style>
  header {
    border-bottom: 1px solid var(--color-border);
  }
  nav {
    max-width: 780px;
    margin: 0 auto;
    padding: 1rem 1.5rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .site-title {
    font-weight: 700;
    font-size: 1.1rem;
    text-decoration: none;
    color: var(--color-text);
  }
  .links a {
    margin-left: 1rem;
    text-decoration: none;
    color: var(--color-muted);
    font-size: 0.95rem;
  }
  .links a:hover {
    color: var(--color-accent);
  }
</style>
