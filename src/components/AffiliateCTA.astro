---
import { getOffer } from "../config/affiliate";

export interface Props {
  offerKey: string;
}

const { offerKey } = Astro.props;
const offer = getOffer(offerKey);
---
<div class="cta">
  <a href={offer.url} rel="nofollow sponsored noopener" target="_blank">
    {offer.ctaText} &rarr;
  </a>
</div>

<style>
  .cta {
    margin: 1.5rem 0;
    text-align: center;
  }
  .cta a {
    display: inline-block;
    background: var(--color-accent);
    color: #fff;
    text-decoration: none;
    font-weight: 600;
    padding: 0.85rem 1.5rem;
    border-radius: 6px;
  }
  .cta a:hover {
    opacity: 0.9;
  }
</style>
